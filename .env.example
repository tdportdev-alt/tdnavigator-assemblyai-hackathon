# Server-side only. Never expose these to the browser.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_AGENT_ID=

# Public-demo guard for the token route (optional; unset = no checks, for a driver's own tablet).
TDNAV_PUBLIC_DEMO_GUARD=1
TDNAV_DEMO_ALLOWED_ORIGINS=https://tdnav.com,https://www.tdnav.com
TDNAV_DEMO_TOKENS_PER_IP=6
TDNAV_DEMO_IP_WINDOW_S=600
TDNAV_DEMO_TOKENS_PER_HOUR=30
TDNAV_DEMO_TOKENS_PER_DAY=100
TDNAV_DEMO_MAX_SESSION_S=600
TDNAV_DEMO_TOKEN_TTL_S=15
